# Minecraft server address
MC_HOST=localhost
MC_PORT=49615

# Use "offline" for an offline-mode/local server. Use "microsoft" for a
# normal Java Edition Microsoft account; the first run prints a login code.
MC_AUTH=offline
MC_USERNAME=MineflayerBot

# This server runs Minecraft Java 1.21.11.
MC_VERSION=1.21.11

# Comma-separated names allowed to run chat commands. Leave blank to allow all.
ALLOWED_USERS=KawaiiSponge
AI_COMMAND_PREFIX=

# Whispers are always supported. To also accept public chat, enable this and
# set a prefix so ordinary conversation cannot accidentally command the bot.
PUBLIC_CHAT_COMMANDS=false

# Resumable goals and validated local JSON building schematics.
BOT_CHECKPOINT_FILE=.state/active-goal.json
BOT_LANDMARKS_FILE=.state/landmarks.json
SCHEMATICS_DIRECTORY=schematics

# Local OpenAI-compatible AI service.
AI_BASE_URL=http://127.0.0.1:8080/v1
AI_MODEL=gemma-4-26b-a4b-it
AI_API_KEY=
AI_TIMEOUT_MS=120000

# Safety boundaries for AI-generated plans.
MAX_ACTIONS_PER_PLAN=8
MAX_PLANS_PER_GOAL=6
MAX_CONSECUTIVE_AI_FAILURES=6
MAX_MOVE_DISTANCE=128
MAX_EXPEDITION_DISTANCE=2048
OBSERVATION_DISTANCE=16
PATHFINDER_THINK_TIMEOUT_MS=15000
PATHFINDER_SEARCH_RADIUS=32
LOCAL_PATHFINDER_SEARCH_RADIUS=10
BUILD_SITE_SEARCH_RADIUS=24
TASK_STALL_MS=12000
COLLECT_SEARCH_DISTANCE=64
COLLECT_MAX_PATH_FAILURES=4
EQUIPMENT_REQUEST_WAIT_MS=60000
MAX_AUTONOMOUS_TUNNEL_LENGTH=1024
MEMORY_RESTART_MB=1536

# Comma-separated Minecraft registry names dropped after entering inventory.
AUTO_DISPOSE_ITEMS=rotten_flesh

# Reconnect after a disconnect. Set to false to exit instead.
AUTO_RECONNECT=true
RECONNECT_DELAY_MS=5000
RECONNECT_MAX_DELAY_MS=60000

# Microsoft login tokens are cached here and ignored by git.
PROFILES_FOLDER=.auth
